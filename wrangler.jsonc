{
  "name": "naati-ccl",
  "main": "worker.js",
  "compatibility_date": "2025-09-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naati-ccl-db",
      "database_id": "9aa94677-b707-4df2-b270-9168c9d4f24b"
    }
  ],
  "routes": [
    {
      "pattern": "naati.theradicalparty.com/*",
      "zone_name": "theradicalparty.com"
    }
  ]
}
